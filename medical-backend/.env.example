# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment Variable Reference
#
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# .env is listed in .gitignore — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string
# Local development (default — MongoDB running on your machine):
MONGO_URI=mongodb://127.0.0.1:27017/mediqueue

# MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mediqueue?retryWrites=true&w=majority

# Server port (defaults to 5000 if not set)
PORT=5000

# Node environment: development | production | test
NODE_ENV=development
